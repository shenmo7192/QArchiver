# C++ objects and libs
*.slo
*.lo
*.o
*.a
*.la
*.lai
*.so
*.so.*
*.dll
*.dylib

# Bundled 7-Zip engine: 7z.dll is required next to 7z.exe.
!third_party/7zip/win/x64/7z.dll
!third_party/7zip/win/arm64/7z.dll

# Qt-es
object_script.*.Release
object_script.*.Debug
*_plugin_import.cpp
/.qmake.cache
/.qmake.stash
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
Makefile*
*build-*
build/
*.qm
!translations/*.qm
*.prl
*.qmlls.ini

# Qt unit tests
target_wrapper.*

# QtCreator
*.autosave

# QtCreator Qml
*.qmlproject.user
*.qmlproject.user.*

# QtCreator CMake
CMakeLists.txt.user*

# QtCreator 4.8< compilation database
compile_commands.json

# QtCreator local machine specific files for imported projects
*creator.user*

*_qmlcache.qrc

# Python bytecode from the asset scripts
__pycache__/
*.pyc

# Scratch directory for assets/files awaiting manual cleanup
tmp/

# Local drag & drop investigation logs (user's own records, not part of the repo)
/*.log

# Windows cross-build staging
build-windows/
build-windows-host-qt/

# Build tooling scripts whose names match *build-*
!tools/build-windows-cross.sh
!tools/uninstall-build-deps.sh
!packaging/windows/build-installer.ps1

# Debian build artifacts
obj-*/
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/yincolor.qarchiver/
debian/yincolor.qarchiver.debhelper.log
debian/yincolor.qarchiver.substvars
debian/*.debhelper
yincolor.qarchiver-build-deps_*
# dpkg-buildpackage writes these next to the source tree
*.deb
*.dsc
*.changes
*.buildinfo

# Cross-build lock
.build-windows.lock

# CI/release staging
dist/
_CPack_Packages/

# Local CPack/installer output
QArchiver-*-windows-*.zip
QArchiver-*-windows-*-setup.exe

.pi/
